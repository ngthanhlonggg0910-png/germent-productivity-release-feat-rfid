<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet id="20260604120000-1" author="nvsoft">
        <createTable tableName="pro_nscl_log">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="chuyen" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="ngay_san_xuat" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="ma_hang" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="po" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="thoi_gian_bam_lan_dau" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="thoi_gian_bam_lan_cuoi" type="datetime">
                <constraints nullable="true"/>
            </column>
            <column name="nguoi_cap_nhat" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="pro_san_pham_id" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="check_point_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="khsx_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="pro_nscl_id" type="bigint">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <addUniqueConstraint
            tableName="pro_nscl_log"
            columnNames="check_point_id, khsx_id"
            constraintName="ux_pro_nscl_log_checkpoint_khsx"/>
    </changeSet>

</databaseChangeLog>
