<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
    <!--
        Added the constraints for entity SysFunction.
    -->
    <changeSet id="20191112105555-2" author="jhipster">
        
        <addForeignKeyConstraint baseColumnNames="sys_permission_id"
                                 baseTableName="sys_function"
                                 constraintName="fk_sys_function_sys_permission_id"
                                 referencedColumnNames="id"
                                 referencedTableName="sys_permission"/>

        <addForeignKeyConstraint baseColumnNames="sys_module_id"
                                 baseTableName="sys_function"
                                 constraintName="fk_sys_function_sys_module_id"
                                 referencedColumnNames="id"
                                 referencedTableName="sys_module"/>

    </changeSet>
</databaseChangeLog>
