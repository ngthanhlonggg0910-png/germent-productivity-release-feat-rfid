    <!--
        Added the entity ProGioLamViec.
    -->
    <changeSet id="20200410135657-1" author="jhipster">
        <createTable tableName="pro_gio_lam_viec">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="gio_bat_dau" type="datetime">
                <constraints nullable="false" />
            </column>
            <column name="gio_ket_thuc" type="datetime">
                <constraints nullable="false" />
            </column>
            <column name="gio_lam" type="nvarchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="thoi_gian" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="caption_tv" type="nvarchar(255)">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here, do not remove-->
        </createTable>
        <dropDefaultValue tableName="pro_gio_lam_viec" columnName="gio_bat_dau" columnDataType="datetime"/>
        <dropDefaultValue tableName="pro_gio_lam_viec" columnName="gio_ket_thuc" columnDataType="datetime"/>
    </changeSet>

